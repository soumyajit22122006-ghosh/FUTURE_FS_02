<div class="py-5">

    <div class="container">

        <!-- Page Header -->

        <div class="mb-5">

            <p class="section-label mb-2">
                LEAD MANAGEMENT
            </p>

            <h1 class="fw-bold mb-2">
                Lead Dashboard
            </h1>

            <p class="text-secondary mb-0">
                Get a quick overview of your leads and their current status.
            </p>

        </div>


        <!-- Dashboard Cards -->

        <div class="row g-4">


            <!-- Total Leads -->

            <div class="col-md-6 col-xl-4">

                <div class="dashboard-card">

                    <div class="dashboard-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div>

                        <p class="dashboard-label">
                            Total Leads
                        </p>

                        <h3 class="dashboard-number">
                            <%= totalLeads %>
                        </h3>

                    </div>

                </div>

            </div>


            <!-- New Leads -->

            <div class="col-md-6 col-xl-4">

                <a
                    href="/lead-management/leads?status=New"
                    class="dashboard-card text-decoration-none"
                >

                    <div class="dashboard-icon">
                        <i class="fa-solid fa-user-plus"></i>
                    </div>

                    <div>

                        <p class="dashboard-label">
                            New Leads
                        </p>

                        <h3 class="dashboard-number">
                            <%= newLeads %>
                        </h3>

                    </div>

                </a>

            </div>


            <!-- Contacted Leads -->

            <div class="col-md-6 col-xl-4">

                <a
                    href="/lead-management/leads?status=Contacted"
                    class="dashboard-card text-decoration-none"
                >

                    <div class="dashboard-icon">
                        <i class="fa-solid fa-phone"></i>
                    </div>

                    <div>

                        <p class="dashboard-label">
                            Contacted
                        </p>

                        <h3 class="dashboard-number">
                            <%= contactedLeads %>
                        </h3>

                    </div>

                </a>

            </div>


            <!-- Follow-up Leads -->

            <div class="col-md-6 col-xl-4">

                <a
                    href="/lead-management/leads?status=Follow-up"
                    class="dashboard-card text-decoration-none"
                >

                    <div class="dashboard-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div>

                        <p class="dashboard-label">
                            Follow-ups
                        </p>

                        <h3 class="dashboard-number">
                            <%= followUpLeads %>
                        </h3>

                    </div>

                </a>

            </div>


            <!-- Converted Leads -->

            <div class="col-md-6 col-xl-4">

                <a
                    href="/lead-management/leads?status=Converted"
                    class="dashboard-card text-decoration-none"
                >

                    <div class="dashboard-icon">
                        <i class="fa-solid fa-circle-check"></i>
                    </div>

                    <div>

                        <p class="dashboard-label">
                            Converted
                        </p>

                        <h3 class="dashboard-number">
                            <%= convertedLeads %>
                        </h3>

                    </div>

                </a>

            </div>


            <!-- Lost Leads -->

            <div class="col-md-6 col-xl-4">

                <a
                    href="/lead-management/leads?status=Lost"
                    class="dashboard-card text-decoration-none"
                >

                    <div class="dashboard-icon">
                        <i class="fa-solid fa-circle-xmark"></i>
                    </div>

                    <div>

                        <p class="dashboard-label">
                            Lost
                        </p>

                        <h3 class="dashboard-number">
                            <%= lostLeads %>
                        </h3>

                    </div>

                </a>

            </div>


        </div>


        <!-- Quick Actions -->

        <div class="mt-5">

            <div class="feature-card">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">

                    <div>

                        <p class="section-label mb-2">
                            QUICK ACTIONS
                        </p>

                        <h4 class="fw-bold mb-1">
                            Manage your leads
                        </h4>

                        <p class="text-secondary mb-0">
                            Add a new enquiry or view all your leads.
                        </p>

                    </div>


                    <div class="d-flex gap-2 flex-wrap">

                        <a
                            href="/enquiry"
                            class="btn btn-primary"
                        >
                            <i class="fa-solid fa-user-plus me-2"></i>
                            Add Lead
                        </a>


                        <a
                            href="/lead-management/leads"
                            class="btn btn-outline-primary"
                        >
                            <i class="fa-solid fa-users me-2"></i>
                            View All Leads
                        </a>

                    </div>

                </div>

            </div>

        </div>


    </div>

</div>
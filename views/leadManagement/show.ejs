<div class="py-5">

    <div class="container">

        <!-- Page Header -->

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">

            <div>

                <p class="section-label mb-2">
                    LEAD DETAILS
                </p>

                <h1 class="fw-bold mb-2">
                    <%= lead.name %>
                </h1>

                <p class="text-secondary mb-0">
                    View and manage lead information.
                </p>

            </div>

            <a
                href="/lead-management/leads"
                class="btn btn-outline-secondary"
            >
                <i class="fa-solid fa-arrow-left me-2"></i>
                Back to Leads
            </a>

        </div>


        <!-- Lead Information -->

        <div class="row g-4">

            <!-- Contact Information -->

            <div class="col-lg-8">

                <div class="feature-card h-100">

                    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">

                        <div>

                            <p class="section-label mb-2">
                                CONTACT INFORMATION
                            </p>

                            <h4 class="fw-bold mb-0">
                                Lead Information
                            </h4>

                        </div>


                        <!-- Status Badge -->

                        <%
                            let statusClass = "bg-primary-subtle text-primary-emphasis";

                            if (lead.status === "Contacted") {
                                statusClass = "bg-info-subtle text-info-emphasis";
                            }

                            if (lead.status === "Follow-up") {
                                statusClass = "bg-warning-subtle text-warning-emphasis";
                            }

                            if (lead.status === "Converted") {
                                statusClass = "bg-success-subtle text-success-emphasis";
                            }

                            if (lead.status === "Lost") {
                                statusClass = "bg-danger-subtle text-danger-emphasis";
                            }
                        %>

                        <span class="badge <%= statusClass %> px-3 py-2">
                            <%= lead.status %>
                        </span>

                    </div>


                    <div class="row g-4">

                        <!-- Name -->

                        <div class="col-md-6">

                            <p class="text-secondary small mb-1">
                                Name
                            </p>

                            <p class="fw-semibold mb-0">
                                <%= lead.name %>
                            </p>

                        </div>


                        <!-- Phone -->

                        <div class="col-md-6">

                            <p class="text-secondary small mb-1">
                                Phone
                            </p>

                            <p class="fw-semibold mb-0">
                                <%= lead.phone %>
                            </p>

                        </div>


                        <!-- Email -->

                        <div class="col-md-6">

                            <p class="text-secondary small mb-1">
                                Email
                            </p>

                            <p class="fw-semibold mb-0">
                                <%= lead.email || "-" %>
                            </p>

                        </div>


                        <!-- Company -->

                        <div class="col-md-6">

                            <p class="text-secondary small mb-1">
                                Company / Organization
                            </p>

                            <p class="fw-semibold mb-0">
                                <%= lead.company || "-" %>
                            </p>

                        </div>


                        <!-- Follow-up -->

                        <div class="col-md-6">

                            <p class="text-secondary small mb-1">
                                Follow-up Date
                            </p>

                            <p class="fw-semibold mb-0">

                                <% if (lead.followUpDate) { %>

                                    <%= new Date(lead.followUpDate).toLocaleDateString("en-IN", {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    }) %>

                                <% } else { %>

                                    -

                                <% } %>

                            </p>

                        </div>


                        <!-- Created Date -->

                        <div class="col-md-6">

                            <p class="text-secondary small mb-1">
                                Added On
                            </p>

                            <p class="fw-semibold mb-0">

                                <%= new Date(lead.createdAt).toLocaleDateString("en-IN", {
                                    day: "2-digit",
                                    month: "short",
                                    year: "numeric"
                                }) %>

                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Actions -->

            <div class="col-lg-4">

                <div class="feature-card h-100">

                    <p class="section-label mb-2">
                        ACTIONS
                    </p>

                    <h4 class="fw-bold mb-4">
                        Manage Lead
                    </h4>


                    <div class="d-grid gap-2">

                        <!-- Edit Lead -->

                        <a
                            href="/lead-management/leads/<%= lead._id %>/edit"
                            class="btn btn-primary"
                        >
                            <i class="fa-solid fa-pen-to-square me-2"></i>
                            Edit Lead
                        </a>


                        <!-- Edit Note -->

                        <a
                            href="/lead-management/leads/<%= lead._id %>/note/edit"
                            class="btn btn-outline-primary"
                        >
                            <i class="fa-solid fa-note-sticky me-2"></i>
                            Edit Note
                        </a>


                        <!-- Delete Lead -->

                        <form
                            action="/lead-management/leads/<%= lead._id %>?_method=DELETE"
                            method="POST"
                            onsubmit="return confirm('Are you sure you want to delete this lead?');"
                        >

                            <button
                                type="submit"
                                class="btn btn-outline-danger w-100"
                            >
                                <i class="fa-solid fa-trash me-2"></i>
                                Delete Lead
                            </button>

                        </form>

                    </div>

                </div>

            </div>


            <!-- Lead Note -->

            <div class="col-12">

                <div class="feature-card">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                        <div>

                            <p class="section-label mb-2">
                                LEAD NOTE
                            </p>

                            <h4 class="fw-bold mb-0">
                                Communication Note
                            </h4>

                        </div>


                        <a
                            href="/lead-management/leads/<%= lead._id %>/note/edit"
                            class="btn btn-sm btn-outline-primary"
                        >
                            <i class="fa-solid fa-pen me-2"></i>
                            Edit Note
                        </a>

                    </div>


                    <% if (lead.note) { %>

                        <div class="p-4 bg-light rounded-3">

                            <p class="mb-0 text-secondary">
                                <%= lead.note %>
                            </p>

                        </div>

                    <% } else { %>

                        <div class="p-4 bg-light rounded-3 text-center">

                            <i class="fa-solid fa-note-sticky fs-3 text-secondary mb-3"></i>

                            <p class="mb-0 text-secondary">
                                No note has been added for this lead yet.
                            </p>

                        </div>

                    <% } %>

                </div>

            </div>

        </div>

    </div>

</div>
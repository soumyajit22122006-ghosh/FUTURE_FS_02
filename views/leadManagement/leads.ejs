<div class="py-5">

    <div class="container">

        <!-- Page Header -->

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">

            <div>

                <p class="section-label mb-2">
                    LEAD MANAGEMENT
                </p>

                <h1 class="fw-bold mb-2">
                    All Leads
                </h1>

                <p class="text-secondary mb-0">
                    View and manage all your potential clients.
                </p>

            </div>


            <a
                href="/enquiry"
                class="btn btn-primary"
            >
                <i class="fa-solid fa-user-plus me-2"></i>
                Add Lead
            </a>

        </div>


        <!-- Search & Filters -->

        <div class="feature-card mb-4">

            <form
                action="/lead-management/leads"
                method="GET"
            >

                <div class="row g-3 align-items-end">

                    <!-- Search -->

                    <div class="col-lg-5">

                        <label
                            for="search"
                            class="form-label fw-semibold"
                        >
                            Search Leads
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="fa-solid fa-magnifying-glass text-secondary"></i>
                            </span>

                            <input
                                type="text"
                                class="form-control"
                                id="search"
                                name="search"
                                value="<%= search || '' %>"
                                placeholder="Search by name, phone, email, or company..."
                            >

                        </div>

                    </div>


                    <!-- Status -->

                    <div class="col-lg-2">

                        <label
                            for="status"
                            class="form-label fw-semibold"
                        >
                            Status
                        </label>

                        <select
                            class="form-select"
                            id="status"
                            name="status"
                        >

                            <option value="">
                                All Statuses
                            </option>

                            <option
                                value="New"
                                <%= status === "New" ? "selected" : "" %>
                            >
                                New
                            </option>

                            <option
                                value="Contacted"
                                <%= status === "Contacted" ? "selected" : "" %>
                            >
                                Contacted
                            </option>

                            <option
                                value="Follow-up"
                                <%= status === "Follow-up" ? "selected" : "" %>
                            >
                                Follow-up
                            </option>

                            <option
                                value="Converted"
                                <%= status === "Converted" ? "selected" : "" %>
                            >
                                Converted
                            </option>

                            <option
                                value="Lost"
                                <%= status === "Lost" ? "selected" : "" %>
                            >
                                Lost
                            </option>

                        </select>

                    </div>


                    <!-- Follow-up -->

                    <div class="col-lg-2">

                        <label
                            for="followUp"
                            class="form-label fw-semibold"
                        >
                            Follow-up
                        </label>

                        <select
                            class="form-select"
                            id="followUp"
                            name="followUp"
                        >

                            <option value="">
                                All Follow-ups
                            </option>

                            <option
                                value="today"
                                <%= followUp === "today" ? "selected" : "" %>
                            >
                                Today
                            </option>

                            <option
                                value="upcoming"
                                <%= followUp === "upcoming" ? "selected" : "" %>
                            >
                                Upcoming
                            </option>

                            <option
                                value="overdue"
                                <%= followUp === "overdue" ? "selected" : "" %>
                            >
                                Overdue
                            </option>

                        </select>

                    </div>


                    <!-- Buttons -->

                    <div class="col-lg-3 d-flex gap-2">

                        <button
                            type="submit"
                            class="btn btn-primary flex-grow-1"
                        >
                            <i class="fa-solid fa-filter me-2"></i>
                            Apply
                        </button>


                        <a
                            href="/lead-management/leads"
                            class="btn btn-outline-secondary"
                            title="Clear search and filters"
                        >
                            <i class="fa-solid fa-xmark"></i>
                        </a>

                    </div>

                </div>

            </form>

        </div>


        <!-- Leads Table -->

        <div class="table-responsive bg-white border rounded-4">

            <table class="table align-middle mb-0">

                <thead>

                    <tr>

                        <th class="px-4 py-3">
                            Name
                        </th>

                        <th class="py-3">
                            Phone
                        </th>

                        <th class="py-3">
                            Email
                        </th>

                        <th class="py-3">
                            Company
                        </th>

                        <th class="py-3">
                            Status
                        </th>

                        <th class="py-3">
                            Follow-up
                        </th>

                        <th class="py-3 text-end px-4">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    <% if (leads.length === 0) { %>

                        <tr>

                            <td
                                colspan="7"
                                class="text-center py-5"
                            >

                                <i class="fa-solid fa-users-slash fs-2 text-secondary mb-3"></i>

                                <p class="mb-0 text-secondary">
                                    No leads found.
                                </p>

                            </td>

                        </tr>

                    <% } %>


                    <% leads.forEach(lead => { %>

                        <tr>

                            <!-- Name -->

                            <td class="px-4">

                                <div class="fw-semibold">
                                    <%= lead.name %>
                                </div>

                            </td>


                            <!-- Phone -->

                            <td>

                                <%= lead.phone %>

                            </td>


                            <!-- Email -->

                            <td>

                                <%= lead.email || "-" %>

                            </td>


                            <!-- Company -->

                            <td>

                                <%= lead.company || "-" %>

                            </td>


                            <!-- Status -->

                            <td>

                                <%
                                    let statusClass = "bg-primary-subtle text-primary-emphasis";

                                    if (lead.status === "Contacted") {
                                        statusClass = "bg-info-subtle text-info-emphasis";
                                    }

                                    if (lead.status === "Follow-up") {
                                        statusClass = "bg-warning-subtle text-warning-emphasis";
                                    }

                                    if (lead.status === "Converted") {
                                        statusClass = "bg-success-subtle text-success-emphasis";
                                    }

                                    if (lead.status === "Lost") {
                                        statusClass = "bg-danger-subtle text-danger-emphasis";
                                    }
                                %>

                                <span class="badge <%= statusClass %>">

                                    <%= lead.status %>

                                </span>

                            </td>


                            <!-- Follow-up -->

                            <td>

                                <% if (lead.followUpDate) { %>

                                    <%= new Date(lead.followUpDate).toLocaleDateString("en-IN", {
                                        day: "2-digit",
                                        month: "short",
                                        year: "numeric"
                                    }) %>

                                <% } else { %>

                                    <span class="text-secondary">
                                        -
                                    </span>

                                <% } %>

                            </td>


                            <!-- Action -->

                            <td class="text-end px-4">

                                <a
                                    href="/lead-management/leads/<%= lead._id %>"
                                    class="btn btn-sm btn-outline-primary"
                                    title="View Lead"
                                >

                                    <i class="fa-solid fa-eye"></i>

                                </a>

                            </td>

                        </tr>

                    <% }) %>

                </tbody>

            </table>

        </div>

    </div>

</div>
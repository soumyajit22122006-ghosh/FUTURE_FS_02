<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >
    <title><%= title || "LeadSphere" %></title>
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >
    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
        crossorigin
    >
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >
    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
    >
    <link
        rel="stylesheet"
        href="/css/style.css"
    >
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom sticky-top">
        <div class="container py-2">
            <a
                href="/"
                class="navbar-brand d-flex align-items-center gap-2"
            >
                <span class="brand-icon">
                    <i class="fa-solid fa-people-arrows"></i>
                </span>
                <span class="brand-name">
                    LeadSphere
                </span>
            </a>
            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#mainNavbar"
                aria-controls="mainNavbar"
                aria-expanded="false"
                aria-label="Toggle navigation"
            >
                <span class="navbar-toggler-icon"></span>
            </button>
            <div
                class="collapse navbar-collapse"
                id="mainNavbar"
            >
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
                    <li class="nav-item">
                        <a
                            class="nav-link <%= activePage === 'home' ? 'active' : '' %>"
                            href="/"
                        >
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a
                            class="nav-link <%= activePage === 'enquiry' ? 'active' : '' %>"
                            href="/enquiry"
                        >
                            Enquiry
                        </a>
                    </li>
                    <li class="nav-item">
                        <a
                            class="nav-link <%= activePage === 'lead-management' ? 'active' : '' %>"
                            href="/lead-management"
                        >
                            Lead Management
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <main class="flex-grow-1">
        <%- body %>
    </main>
    <footer class="footer">
        <div class="container text-center">
            <p class="mb-0">
                &copy; 2026 LeadSphere.
                Turn Leads Into Relationships.
            </p>
            <p class="mb-0">SOUMYAJIT GHOSH</p>
        </div>
    </footer>
    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
    <script src="/js/script.js"></script>
</body>
</html>
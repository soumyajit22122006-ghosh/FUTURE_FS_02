<div class="py-5">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="mb-5">

                    <p class="section-label mb-2">
                        NEW ENQUIRY
                    </p>

                    <h1 class="fw-bold mb-2">
                        Add New Lead
                    </h1>

                    <p class="text-secondary mb-0">
                        Add a potential client to your LeadSphere workspace.
                    </p>

                </div>


                <div class="feature-card">

                    <form
                        action="/enquiry"
                        method="POST"
                    >

                        <!-- Name -->

                        <div class="mb-4">

                            <label
                                for="name"
                                class="form-label fw-semibold"
                            >
                                Name
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="name"
                                name="name"
                                placeholder="Enter lead name"
                                required
                            >

                        </div>


                        <!-- Phone -->

                        <div class="mb-4">

                            <label
                                for="phone"
                                class="form-label fw-semibold"
                            >
                                Phone
                            </label>

                            <input
                                type="tel"
                                class="form-control"
                                id="phone"
                                name="phone"
                                placeholder="Enter 10-digit phone number"
                                pattern="[0-9]{10}"
                                maxlength="10"
                                inputmode="numeric"
                                required
                            >

                            <div class="form-text">
                                Enter exactly 10 digits.
                            </div>

                        </div>


                        <!-- Email -->

                        <div class="mb-4">

                            <label
                                for="email"
                                class="form-label fw-semibold"
                            >
                                Email
                            </label>

                            <input
                                type="email"
                                class="form-control"
                                id="email"
                                name="email"
                                placeholder="Enter email address"
                            >

                        </div>


                        <!-- Company -->

                        <div class="mb-4">

                            <label
                                for="company"
                                class="form-label fw-semibold"
                            >
                                Company / Organization
                            </label>

                            <input
                                type="text"
                                class="form-control"
                                id="company"
                                name="company"
                                placeholder="Enter company or organization"
                            >

                        </div>


                        <!-- Note -->

                        <div class="mb-4">

                            <label
                                for="note"
                                class="form-label fw-semibold"
                            >
                                Note
                            </label>

                            <textarea
                                class="form-control"
                                id="note"
                                name="note"
                                rows="5"
                                placeholder="Add an initial note if needed..."
                            ></textarea>

                        </div>


                        <!-- Buttons -->

                        <div class="d-flex justify-content-end gap-2">

                            <a
                                href="/"
                                class="btn btn-outline-secondary"
                            >
                                Cancel
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                <i class="fa-solid fa-user-plus me-2"></i>
                                Add Lead
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>